{
  "database": {
    "server": "HOME-PC",
    "database": "TrafficMonitor",
    "trusted_connection": true,
    "driver": "ODBC Driver 17 for SQL Server",
    "timeout": 15
  },
  "sniffer": {
    "interface": "",
    "packet_limit": 0,
    "timeout_seconds": 0
  },
  "analysis": {
    "port_scan_threshold": 15,
    "connection_threshold": 50,
    "request_rate_threshold": 100,
    "suspicious_ports": [4444, 5555, 31337, 6666, 8888, 12345, 27374, 1234],
    "log_level": "INFO",
    "log_file": "network_monitor.log"
  },
  "load_test": {
    "target_ip": "127.0.0.1",
    "target_port": 80,
    "threads": 50,
    "packets_per_thread": 1000,
    "protocol": "TCP"
  },
  "ui": {
    "theme": "Fusion",
    "auto_refresh_ms": 1000,
    "max_table_rows": 5000
  }
}